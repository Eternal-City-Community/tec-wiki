{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tec-wiki",
  "main": "./src/worker.js",
  "compatibility_date": "2026-09-30",
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "run_worker_first": [
      "/auth",
      "/callback",
      "/api/*"
    ]
  }
}
