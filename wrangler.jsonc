{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tec-wiki",
  "main": "./src/worker.js",
  "compatibility_date": "2026-09-30",
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "run_worker_first": [
      "/auth",
      "/callback",
      "/api/*",
      "/admin/config.yml"
    ]
  },
  "kv_namespaces": [
    {
      "binding": "BIO_EDIT_CODES",
      "id": "5fc2c163d4d34fc9a6cadc783a020196"
    }
  ],
  "build": {
    "command": "mkdocs build --clean"
  },
  "vars": {
    "BIO_TURNSTILE_SITE_KEY": "0x4AAAAAAFW5CvcMWb-nnJ6R"
  },
  "previews": {}
}
